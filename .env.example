# Copy to .env and fill in. .env is gitignored.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Must be identical for every service and at least 32 characters (HS256 needs a
# 256-bit key). If services disagree, tokens issued by user-service silently fail
# to validate everywhere else.
JWT_SECRET=change-me-to-a-long-random-value-of-32-chars-or-more
JWT_EXPIRATION_MS=36000000

# Comma-separated. Only needed for browsers arriving from another origin.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Published host ports. Override if an IntelliJ run already holds 8080/8761.
GATEWAY_PORT=8080
EUREKA_PORT=8761
